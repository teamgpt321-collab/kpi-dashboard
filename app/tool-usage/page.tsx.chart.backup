"use client";

import { useEffect, useMemo, useState } from "react";

import {
    BarChart,
    Bar,
    XAxis,
    YAxis,
    Tooltip,
    ResponsiveContainer,
    Legend
} from "recharts";


const toolColors:any = {
    osp:"#9333ea",
    bypass:"#2563eb",
    thong_tin_khach:"#16a34a",
    kiem_tra_port:"#f97316"
};


export default function ToolUsagePage(){

    const [data,setData] = useState<any>(null);

    const [tool,setTool] = useState("all");
    const [user,setUser] = useState("all");

    const [fromDate,setFromDate] = useState("");
    const [toDate,setToDate] = useState("");



    useEffect(()=>{

        fetch("/api/tool-usage")
        .then(res=>res.json())
        .then(setData)

    },[]);



    const history = data?.history || [];



    const tools = useMemo(()=>{

        return [
            "all",
            ...Array.from(
                new Set(
                    history.map(
                        (x:any)=>x.tool
                    )
                )
            )
        ];

    },[history]);



    const users = useMemo(()=>{

        return [
            "all",
            ...Array.from(
                new Set(
                    history.map(
                        (x:any)=>x.userName
                    )
                )
            )
        ];

    },[history]);





    const filteredHistory = useMemo(()=>{


        return history.filter(
            (item:any)=>{


                const date =
                    item.time.substring(0,10);



                return (

                    (
                        tool==="all"
                        ||
                        item.tool===tool
                    )

                    &&

                    (
                        user==="all"
                        ||
                        item.userName===user
                    )

                    &&

                    (
                        !fromDate
                        ||
                        date>=fromDate
                    )

                    &&

                    (
                        !toDate
                        ||
                        date<=toDate
                    )

                );

            }
        );


    },[
        history,
        tool,
        user,
        fromDate,
        toDate
    ]);





    const toolCount:any = {};


    filteredHistory.forEach(
        (item:any)=>{

            toolCount[item.tool] =
                (toolCount[item.tool] || 0) + 1;

        }
    );




    const topUsers:any = Object.values(

        filteredHistory.reduce(
            (acc:any,item:any)=>{

                if(!acc[item.userName]){

                    acc[item.userName]={
                        name:item.userName,
                        count:0
                    };

                }


                acc[item.userName].count++;


                return acc;

            },
            {}
        )

    )
    .sort(
        (a:any,b:any)=>b.count-a.count
    );





    const chartData:any = Object.values(

        filteredHistory.reduce(
            (acc:any,item:any)=>{


                const date =
                    item.time.substring(0,10);



                if(!acc[date]){

                    acc[date]={
                        date
                    };

                }



                acc[date][item.tool] =
                    (acc[date][item.tool] || 0)+1;



                return acc;


            },
            {}
        )

    );





    if(!data){

        return (
            <div className="p-10">
                Loading...
            </div>
        );

    }




    return (

        <div className="p-5 bg-slate-50 min-h-screen">


            <h1 className="text-2xl font-bold">
                Tool Usage Dashboard
            </h1>


            <p className="text-sm text-slate-500 mb-5">
                Theo dõi sử dụng các tool Telegram
            </p>





            {/* SUMMARY */}

            <div className="
                grid
                grid-cols-4
                gap-4
                mb-5
            ">


                <div className="bg-white rounded-xl shadow p-5">

                    <div>
                        ⚡ Tổng lượt chạy
                    </div>

                    <div className="text-3xl font-bold">
                        {filteredHistory.length}
                    </div>

                </div>



                {
                    Object.entries(toolCount)
                    .slice(0,2)
                    .map(
                        ([name,count]:any)=>(

                        <div
                            key={name}
                            className="bg-white rounded-xl shadow p-5"
                        >

                            <div>
                                {name}
                            </div>

                            <div className="text-3xl font-bold">
                                {count}
                            </div>

                        </div>

                        )
                    )
                }



                <div className="bg-white rounded-xl shadow p-5">

                    <div>
                        👤 Nhân sự
                    </div>

                    <div className="text-3xl font-bold">
                        {
                            new Set(
                                filteredHistory.map(
                                    (x:any)=>x.user
                                )
                            ).size
                        }
                    </div>

                </div>


            </div>






            {/* FILTER */}

            <div className="bg-white rounded-xl shadow p-5 mb-5">

                <div className="font-bold mb-3">
                    🔎 Bộ lọc
                </div>


                <div className="flex gap-3">


                    <select
                        className="border p-2 rounded"
                        value={tool}
                        onChange={
                            e=>setTool(e.target.value)
                        }
                    >

                        {
                            tools.map(
                                (x:any)=>
                                <option key={x}>
                                    {x}
                                </option>
                            )
                        }

                    </select>




                    <select
                        className="border p-2 rounded"
                        value={user}
                        onChange={
                            e=>setUser(e.target.value)
                        }
                    >

                        {
                            users.map(
                                (x:any)=>
                                <option key={x}>
                                    {x}
                                </option>
                            )
                        }

                    </select>



                    <input
                        type="date"
                        className="border p-2 rounded"
                        value={fromDate}
                        onChange={
                            e=>setFromDate(e.target.value)
                        }
                    />


                    <input
                        type="date"
                        className="border p-2 rounded"
                        value={toDate}
                        onChange={
                            e=>setToDate(e.target.value)
                        }
                    />


                </div>

            </div>







            <div className="grid grid-cols-3 gap-5">


                {/* TOP USER */}

                <div className="bg-white rounded-xl shadow p-5">

                    <h2 className="font-bold mb-3">
                        🏆 Top người dùng
                    </h2>


                    {
                        topUsers.map(
                            (u:any,index:number)=>(

                                <div
                                    key={u.name}
                                    className="
                                    flex
                                    justify-between
                                    py-2
                                    border-b
                                    "
                                >

                                    <span>
                                        {index+1}. {u.name}
                                    </span>


                                    <b>
                                        {u.count}
                                    </b>


                                </div>

                            )
                        )
                    }


                </div>






                {/* HISTORY */}

                <div className="
                    col-span-2
                    bg-white
                    rounded-xl
                    shadow
                    p-5
                ">


                    <h2 className="font-bold mb-3">
                        📋 Lịch sử sử dụng
                    </h2>


                    <table className="w-full text-sm">

                        <thead>

                            <tr className="text-left">

                                <th>Tool</th>
                                <th>Nhân sự</th>
                                <th>SHĐ</th>
                                <th>Thời gian</th>

                            </tr>

                        </thead>


                        <tbody>

                            {
                                filteredHistory
                                .slice(0,10)
                                .map(
                                    (x:any,i:number)=>(

                                    <tr
                                        key={i}
                                        className="border-b"
                                    >

                                        <td>
                                            {x.tool}
                                        </td>

                                        <td>
                                            {x.userName}
                                        </td>

                                        <td>
                                            {x.shd}
                                        </td>

                                        <td>
                                            {x.time}
                                        </td>

                                    </tr>

                                    )
                                )
                            }

                        </tbody>


                    </table>


                </div>


            </div>







            {/* CHART */}

            <div className="
                bg-white
                rounded-xl
                shadow
                p-5
                mt-5
            ">


                <h2 className="font-bold mb-5">
                    📊 Biểu đồ theo ngày
                </h2>


                <ResponsiveContainer
                    width="100%"
                    height={350}
                >

                    <BarChart
                        data={chartData}
                    >

                        <XAxis dataKey="date"/>

                        <YAxis/>

                        <Tooltip/>

                        <Legend/>


                        {
                            tools
                            .filter(
                                (x:any)=>x!=="all"
                            )
                            .map(
                                (x:any)=>(

                                <Bar
                                    key={x}
                                    dataKey={x}
                                    stackId="a"
                                    fill={
                                        toolColors[x]
                                        ||
                                        "#64748b"
                                    }
                                />

                                )
                            )
                        }


                    </BarChart>


                </ResponsiveContainer>


            </div>



        </div>

    );

}
